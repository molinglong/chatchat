generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  conversations Conversation[]
  memories      Memory[]
  customModels  CustomModel[]
  generatedImages GeneratedImage[]
  searchApiKeys  SearchApiKey[]
  memoryEnabled Boolean   @default(true)
  clarifyEnabled Boolean  @default(true)
  imageModel    String   @default("builtin:wanx2.1-t2i-turbo")
  imageSize     String   @default("1024*1024")
  imageModels   ImageModel[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // openai, anthropic, deepseek, qianwen, wenxin
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String
  title         String   @default("新对话")
  model         String   @default("gpt-4o")
  mode          String   @default("single") // single | compare
  compareModels String?  // JSON 数组,如 ["gpt-4o","claude-sonnet"]
  styleOffset   Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id               String   @id @default(cuid())
  conversationId   String
  role             String   // user, assistant, system
  content          String
  reasoning        String?  // AI 思考过程（深度思考 / 推理模型）
  attachments      String?  // JSON string for file URLs
  model            String?  // assistant 消息所属模型 id
  groupId          String?  // 同一轮对比共享的分组 id
  promptTokens     Int?     // 本轮输入 token 数（assistant 消息）
  completionTokens Int?     // 本轮输出 token 数（assistant 消息）
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, groupId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("general")
  content   String
  source    String   @default("auto") // auto 自动提取 | manual 手动添加
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 用户自定义生图模型(OpenAI 兼容文生图端点)
model ImageModel {
  id           String   @id @default(cuid())
  userId       String
  name         String   // 显示名称
  modelId      String   // 实际模型标识,如 "dall-e-3" / "stable-diffusion-xl"
  baseURL      String   // API 端点,如 https://api.openai.com/v1
  apiKeySource String   @default("provider") // "provider" 复用服务商 Key | "own" 独立 Key
  apiKey       String?  // 独立 API Key(加密),keySource=own 时使用
  keyProvider  String?  // 复用哪个服务商的 Key,keySource=provider 时使用
  contextWindow Int     @default(2048) // 备注/上下文限制
  supportsSize Boolean  @default(true)  // 是否支持自定义尺寸
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId])
}

// 用户自定义模型(OpenAI 兼容协议)
model CustomModel {
  id               String   @id @default(cuid())
  userId           String
  name             String // 显示名
  modelId          String // 实际模型标识,如 "gpt-4o-mini" / "qwen2.5:7b"
  baseURL          String // OpenAI 兼容端点,如 https://api.siliconflow.cn/v1
  protocol         String   @default("auto") // auto、chat、responses 或 anthropic
  apiKey           String? // 独立 API Key(加密);为空时复用 keyProvider 的 Key 或免鉴权
  keyProvider      String? // 复用已有服务商 Key 的 provider id(如 "openai")
  contextWindow    Int      @default(32768)
  supportsVision   Boolean  @default(false)
  supportsFiles    Boolean  @default(false)
  supportsReasoning Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId])
}

// 用户通过"生图工作台"生成的图片记录
model GeneratedImage {
  id        String   @id @default(cuid())
  userId    String
  prompt    String   // 用户输入的提示词
  url       String   // 相对路径,如 /uploads/wanx-xxx.png
  model     String   @default("builtin:wanx2.1-t2i-turbo")
  width     Int      @default(1024)
  height    Int      @default(1024)
  size      String   @default("1024*1024") // 生图请求时的尺寸参数(如 1024*1024 / 720*1280 / 1280*720)
  // 关联来源: workspace = 来自生图工作台; chat = 来自对话中的 [IMG] 触发
  source    String   @default("workspace")
  // 二创链路: parentId 指向被修改的原图,null = 首次生成
  parentId  String?
  // 生成方式: t2i(文生图) | edit(以图生图/img2img) | inpaint(局部重绘) | variation(变体)
  editType  String   @default("t2i")
  // inpaint 用: 涂抹区域相对原图的归一化坐标 JSON,形如 {"x":0.1,"y":0.2,"w":0.3,"h":0.4}
  maskRect  String?
  // 文生图时用户上传的参考图(相对路径 /uploads/xxx.png),null = 纯文生图
  referenceImageUrl String?
  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   GeneratedImage?  @relation("ImageDerivation", fields: [parentId], references: [id], onDelete: SetNull)
  children GeneratedImage[] @relation("ImageDerivation")

  @@index([userId, createdAt])
  @@index([parentId])
}

// 联网搜索 API Key（独立于模型 ApiKey 表）
// 目前支持：qianfan（百度千帆）
model SearchApiKey {
  id           String   @id @default(cuid())
  userId       String
  engine       String   // qianfan | tavily | ...
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, engine])
  @@index([userId])
}
