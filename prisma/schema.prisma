generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  conversations Conversation[]
  memories      Memory[]
  customModels  CustomModel[]
  memoryEnabled Boolean   @default(true)
  clarifyEnabled Boolean  @default(true)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // openai, anthropic, deepseek, qianwen, wenxin
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String
  title         String   @default("新对话")
  model         String   @default("gpt-4o")
  mode          String   @default("single") // single | compare
  compareModels String?  // JSON 数组,如 ["gpt-4o","claude-sonnet"]
  styleOffset   Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id               String   @id @default(cuid())
  conversationId   String
  role             String   // user, assistant, system
  content          String
  reasoning        String?  // AI 思考过程（深度思考 / 推理模型）
  attachments      String?  // JSON string for file URLs
  model            String?  // assistant 消息所属模型 id
  groupId          String?  // 同一轮对比共享的分组 id
  promptTokens     Int?     // 本轮输入 token 数（assistant 消息）
  completionTokens Int?     // 本轮输出 token 数（assistant 消息）
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, groupId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("general")
  content   String
  source    String   @default("auto") // auto 自动提取 | manual 手动添加
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 用户自定义模型(OpenAI 兼容协议)
model CustomModel {
  id               String   @id @default(cuid())
  userId           String
  name             String // 显示名
  modelId          String // 实际模型标识,如 "gpt-4o-mini" / "qwen2.5:7b"
  baseURL          String // OpenAI 兼容端点,如 https://api.siliconflow.cn/v1
  protocol         String   @default("auto") // auto、chat、responses 或 anthropic
  apiKey           String? // 独立 API Key(加密);为空时复用 keyProvider 的 Key 或免鉴权
  keyProvider      String? // 复用已有服务商 Key 的 provider id(如 "openai")
  contextWindow    Int      @default(32768)
  supportsVision   Boolean  @default(false)
  supportsFiles    Boolean  @default(false)
  supportsReasoning Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([userId])
}
